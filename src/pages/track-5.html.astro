---
import { readFileSync } from "node:fs";
const source = readFileSync(new URL("../../legacy/track-5.html", import.meta.url), "utf8");
const head = source.split("<head>")[1]?.split("</head>")[0] ?? "";
const body = source.split("<body>")[1]?.split("</body>")[0] ?? "";
---
<html lang="fr" data-lang="fr">
<head><Fragment set:html={head.replaceAll('href="styles.css"', 'href="/styles.css"')} /></head>
<body><Fragment set:html={body} /></body>
</html>
