<!doctype html>
<html lang="fr" data-lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Le Piège du Carnet : des défis pour comprendre les subtilités du français, apprendre de ses erreurs et progresser en s'amusant.">
  <title>Le Piège du Carnet — Défis de français</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@500;600;700&family=Work+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/styles.css">
</head>
<body>
  <div class="grain"></div>
  <header class="site-header">
    <div class="wrap header-inner">
      <a href="/" class="brand">
        <svg class="brand-mark" viewBox="0 0 40 40" width="20" height="20" aria-hidden="true">
          <circle cx="20" cy="20" r="19" fill="none" stroke="currentColor" stroke-width="1.5"/>
          <path d="M14 26c0-6 3-10 6-13 1-1 1-3-1-4-1.5-1-1-2.5.5-2.5 2 0 3 1.5 3 3.5 0 3-1 5-1 8 0 3 2 6 2 9" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
          <circle cx="18.5" cy="8" r="1.6" fill="currentColor"/>
        </svg>
        <span class="brand-name">Le Carnet Ougandais</span>
      </a>
      <nav class="site-nav" aria-label="Page navigation">
        <a href="/" data-fr="Accueil" data-en="Home">Accueil</a>
        <a href="/#culture" data-fr="Culture" data-en="Culture">Culture</a>
        <a href="/#bulletin" data-fr="Bulletin" data-en="Bulletin">Bulletin</a>
      </nav>
      <button class="lang-toggle" id="langToggle" type="button" aria-label="Change language">
        <span class="lang-opt is-active" data-lang-btn="fr">FR</span>
        <span class="lang-sep">/</span>
        <span class="lang-opt" data-lang-btn="en">EN</span>
      </button>
    </div>
  </header>
  <div class="textile-strip" aria-hidden="true"></div>

  <main class="piege-page">
    <div class="wrap">
      <a class="piege-back-link" href="/" data-fr="← Retour au Carnet" data-en="← Back to the notebook">← Retour au Carnet</a>
      <section class="piege-page-hero">
        <p class="eyebrow" data-fr="Le défi de langue du Carnet" data-en="The notebook's French-language challenge">Le défi de langue du Carnet</p>
        <h1 class="piege-page-title">Le Piège <em>du Carnet</em></h1>
        <p class="piege-page-lede" data-fr="Tu connais les mots. Mais connais-tu vraiment leur usage ?" data-en="You know the words. But do you really know how to use them?">Tu connais les mots. Mais connais-tu vraiment leur usage ?</p>
        <p class="piege-page-intro" data-fr="Les pièges sont réunis ici. Choisis l'une des cinq séries thématiques, réponds aux questions et découvre les explications. De nouveaux défis pourront rejoindre chaque série au fil du temps." data-en="All the traps are gathered here. Choose one of the five topic series, answer the questions and explore the explanations. New challenges can be added to each series over time.">Les pièges sont réunis ici. Choisis l'une des cinq séries thématiques, réponds aux questions et découvre les explications. De nouveaux défis pourront rejoindre chaque série au fil du temps.</p>
        <div class="piege-stats" aria-label="Challenge series">
          <span><strong>5</strong><small data-fr="séries thématiques" data-en="topic series">séries thématiques</small></span>
        </div>
      </section>

      <section id="piegeSeries" class="piege-series-section" aria-labelledby="seriesTitle">
        <div class="piege-section-heading">
          <div>
            <p class="eyebrow" data-fr="À toi de jouer" data-en="Your turn">À toi de jouer</p>
            <h2 id="seriesTitle" data-fr="Choisis ta série" data-en="Choose your series">Choisis ta série</h2>
          </div>
          <p data-fr="Des questions. Une bonne dose d'attention." data-en="Fresh challenges. A good dose of attention.">Cinq questions. Une bonne dose d'attention.</p>
        </div>
        <div id="piegeSeriesGrid" class="piege-series-grid"></div>
      </section>

      <section id="piegeQuiz" class="piege-quiz" hidden aria-live="polite">
        <div class="piege-quiz-top">
          <button id="piegeExit" class="piege-text-button" type="button" data-fr="← Toutes les séries" data-en="← All series">← Toutes les séries</button>
          <span id="piegeSeriesLabel" class="piege-series-label"></span>
        </div>
        <div class="piege-progress-row">
          <span id="piegeProgressText">Défi 1 sur 5</span>
          <span id="piegeScoreText">Score : 0 / 5</span>
        </div>
        <div class="piege-progress-track" aria-hidden="true"><span id="piegeProgressBar"></span></div>
        <article class="piege-question-card">
          <div class="piege-question-meta">
            <span id="piegeQuestionNumber">DÉFI 01</span>
            <span data-fr="LE PIÈGE DU JOUR" data-en="THE DAILY TRAP">LE PIÈGE DU JOUR</span>
          </div>
          <h2 id="piegeQuestionTitle"></h2>
          <p id="piegeQuestionText" class="piege-question-text"></p>
          <div id="piegeOptions" class="piege-options"></div>
          <p id="piegeSelectHint" class="piege-select-hint" data-fr="Choisis une réponse avant de valider." data-en="Choose an answer before submitting.">Choisis une réponse avant de valider.</p>
          <button id="piegeSubmit" class="piege-primary-button" type="button" disabled data-fr="Valider ma réponse" data-en="Submit my answer">Valider ma réponse</button>
          <section id="piegeFeedback" class="piege-feedback" hidden>
            <p id="piegeFeedbackBadge" class="piege-feedback-badge"></p>
            <h3 id="piegeFeedbackTitle"></h3>
            <p id="piegeFeedbackBody"></p>
            <div class="piege-takeaway">
              <span id="piegeTakeawayLabel"></span>
              <strong id="piegeTakeaway"></strong>
            </div>
            <div class="piege-example">
              <span id="piegeExampleLabel"></span>
              <p id="piegeExampleFr"></p>
              <p id="piegeExampleEn"></p>
            </div>
            <button id="piegeNext" class="piege-primary-button" type="button" data-fr="Défi suivant →" data-en="Next challenge →">Défi suivant →</button>
          </section>
        </article>
      </section>

      <section id="piegeResult" class="piege-result" hidden aria-live="polite">
        <p class="eyebrow" data-fr="Fin de la série" data-en="Series complete">Fin de la série</p>
        <h2 id="piegeResultTitle"></h2>
        <p id="piegeResultScore" class="piege-result-score"></p>
        <p id="piegeResultMessage"></p>
        <div class="piege-result-actions">
          <button id="piegeReplay" class="piege-primary-button" type="button" data-fr="Rejouer cette série" data-en="Replay this series">Rejouer cette série</button>
          <button id="piegeChooseAnother" class="piege-secondary-button" type="button" data-fr="Choisir une autre série" data-en="Choose another series">Choisir une autre série</button>
        </div>
      </section>
    </div>
  </main>

  <footer class="site-footer piege-footer">
    <div class="wrap footer-inner">
      <div>
        <p class="brand-name small">Le Carnet Ougandais</p>
        <p class="footer-tagline" data-fr="Français & culture, depuis Kampala." data-en="French & culture, from Kampala.">Français & culture, depuis Kampala.</p>
      </div>
      <div class="footer-contact"><a href="/">le-carnet-ougandais.vercel.app</a></div>
    </div>
    <p class="footer-fine" data-fr="Un piège à la fois. Le français devient plus clair." data-en="One trap at a time. French becomes clearer.">Un piège à la fois. Le français devient plus clair.</p>
  </footer>

  <script is:inline src="/lock.js"></script>
  <script is:inline src="/script.js"></script>
  <script is:inline src="/piege-du-carnet.js"></script>
</body>
</html>
