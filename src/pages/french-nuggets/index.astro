---
import legacyHtml from "../../../legacy/index.html?raw";
const source = legacyHtml;
const head = source.split("<head>")[1]?.split("</head>")[0] ?? "";
---
<!doctype html>
<html lang="en">
<head>
  <Fragment set:html={head.replaceAll('href="styles.css"', 'href="/styles.css"')} />
  <title>French Nuggets · Le Carnet Ougandais</title>
  <meta name="description" content="A growing collection of short, clever lessons in everyday French from Le Baguette Bulletin." />
</head>
<body>
  <div class="grain"></div>
  <header class="site-header">
    <div class="wrap header-inner">
      <a href="/" class="brand"><span class="brand-name">Le Carnet Ougandais</span></a>
      <a class="lang-toggle" href="/#bulletin">Back to the Bulletin</a>
    </div>
  </header>
  <main class="section section--bulletin french-nuggets-page">
    <div class="wrap">
      <p class="eyebrow">Same baguette. New crumbs.</p>
      <h1 class="section-title">French Nuggets</h1>
      <p class="section-lede">Short, clever lessons in everyday French — vocabulary, grammar, expressions and the little surprises that make the language human. The collection keeps growing.</p>
      <div class="french-nuggets-page-grid" id="frenchNuggetsPageGrid" aria-live="polite"></div>
    </div>
  </main>
  <script is:inline src="/script.js"></script>
  <script>
    document.addEventListener("DOMContentLoaded", () => {
      const grid = document.getElementById("frenchNuggetsPageGrid");
      if (!grid) return;
      const dateFormat = new Intl.DateTimeFormat("fr-FR", { day: "numeric", month: "long", year: "numeric" });
      const addText = (parent, text, className) => {
        const p = document.createElement("p");
        p.className = className;
        p.textContent = text;
        parent.appendChild(p);
      };
      const entries = [...(window.BULLETINS || [])]
        .sort((a, b) => a.bulletin_number - b.bulletin_number);
      entries.forEach((issue) => {
        const card = document.createElement("article");
        card.className = "french-nugget-entry";

        const imageSlot = document.createElement("div");
        imageSlot.className = "french-nugget-image-placeholder";
        const photo = document.createElement("img");
        photo.className = "french-nugget-photo";
        photo.src = "/images/nugget-" + issue.bulletin_number + ".jpg";
        photo.alt = "French Nuggets No. " + issue.bulletin_number;
        photo.onerror = () => photo.remove();
        imageSlot.appendChild(photo);
        imageSlot.setAttribute("aria-label", "Photo space — upload your own image as /images/nugget-" + issue.bulletin_number + ".jpg");

        const copy = document.createElement("div");
        copy.className = "french-nugget-copy";
        const meta = document.createElement("div");
        meta.className = "bulletin-meta";
        const number = document.createElement("span");
        number.textContent = "No. " + issue.bulletin_number;
        const date = document.createElement("time");
        date.dateTime = issue.created_at;
        date.textContent = dateFormat.format(new Date(issue.created_at + "T12:00:00"));
        meta.append(number, date);

        const title = document.createElement("h2");
        title.textContent = issue.title;
        const caption = document.createElement("div");
        caption.className = "bulletin-caption";
        (issue.caption || "").split(/\n\s*\n/).filter(Boolean).forEach((part) => addText(caption, part, "bulletin-caption-text"));
        const body = document.createElement("div");
        body.className = "bulletin-body";
        (issue.body || "").split(/\n\s*\n/).filter(Boolean).forEach((part) => addText(body, part, "bulletin-body-text"));

        copy.append(meta, title, caption, body);
        card.append(imageSlot, copy);
        grid.appendChild(card);
      });
      if (!entries.length) {
        const empty = document.createElement("p");
        empty.textContent = "The French Nuggets are being prepared. Please refresh shortly.";
        grid.appendChild(empty);
      }
    });
  </script>
</body>
</html>